# Número comercial de WhatsApp en formato internacional, solo dígitos y sin "+".
# Ejemplo de forma (no es un número real): 57XXXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL pública del sitio, usada para metadatos, sitemap y enlaces canónicos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Seguimiento de pedidos (panel /admin) ---
# Conexión a Neon Postgres. La agrega sola la integración de Vercel → Storage → Neon.
DATABASE_URL=
# Contraseña del panel /admin (mínimo 10 caracteres; usa una frase larga).
ADMIN_PASSWORD=
# Clave para firmar la sesión del panel (32+ caracteres aleatorios): openssl rand -base64 32
SESSION_SECRET=
# Solo para pruebas locales sin base de datos: guarda las guías en memoria. Nunca en producción.
# GUIDES_STORE=memory

# --- Catálogo (panel /admin/productos) ---
# Fotos subidas desde el panel. La agrega sola la integración de Vercel → Storage → Blob.
# Sin ella, en desarrollo las fotos se guardan en memoria del servidor (se pierden al reiniciar).
BLOB_READ_WRITE_TOKEN=
# Una tienda nueva arranca sin productos: "none" evita copiar el catálogo inicial de VOLT DJ a la base.
# Solo cuenta la primera vez que se conecta la base.
# CATALOG_SEED=none
# Solo para pruebas locales sin base de datos: catálogo editable en memoria. Nunca en producción.
# CATALOG_STORE=memory
