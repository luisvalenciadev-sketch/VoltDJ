# Número comercial de WhatsApp en formato internacional, solo dígitos y sin "+".
# Ejemplo de forma (no es un número real): 57XXXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL pública del sitio, usada para metadatos, sitemap y enlaces canónicos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Seguimiento de pedidos (panel /admin) ---
# Conexión a Neon Postgres. La agrega sola la integración de Vercel → Storage → Neon.
DATABASE_URL=
# Contraseña del panel /admin (mínimo 10 caracteres; usa una frase larga).
ADMIN_PASSWORD=
# Clave para firmar la sesión del panel (32+ caracteres aleatorios): openssl rand -base64 32
SESSION_SECRET=
# Solo para pruebas locales sin base de datos: guarda las guías en memoria. Nunca en producción.
# GUIDES_STORE=memory
